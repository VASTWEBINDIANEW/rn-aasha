<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Selected -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="45"
                android:startColor="#3B0AB5"
                android:endColor="#E5093A" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <!-- Default -->
    <item>
        <shape android:shape="rectangle">
<gradient android:type="linear" android:angle="45" android:startColor="#3B0AB5" android:endColor="#E5093A"/>
<corners android:radius="6dp"/>
</shape>
    </item>
</selector>